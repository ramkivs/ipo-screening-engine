{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "supplemental-enrichment.v1.schema.json",
  "title": "Supplemental Pre-Score Enrichment Contract (v1.0)",
  "description": "Governed pre-score enrichment contract for non-RHP data (Price Band Notices, Market Bidding/Demand, Peer Multiples, Analyst Qualitative Assessments). Assembled upstream of schema validation and deterministic scoring (Spec s4, Phase 5D).",
  "type": "object",
  "required": [
    "contract_version",
    "ipo_id",
    "as_of",
    "sources"
  ],
  "additionalProperties": false,
  "$defs": {
    "num": {
      "type": [
        "number",
        "null"
      ]
    },
    "int": {
      "type": [
        "integer",
        "null"
      ]
    },
    "pct": {
      "type": [
        "number",
        "null"
      ],
      "minimum": -1000,
      "maximum": 10000
    },
    "date": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "dateTime": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "sourceTypeEnum": {
      "enum": [
        "RHP",
        "DRHP",
        "EXCHANGE",
        "MARKET_DATA",
        "PEER_DATA",
        "STRUCTURED_INPUT",
        "DERIVED"
      ]
    },
    "extractionMethodEnum": {
      "enum": [
        "MANUAL_ENTRY",
        "STRUCTURED_INPUT",
        "DETERMINISTIC_PDF",
        "TABLE_EXTRACTION",
        "OCR",
        "LLM_ASSISTED",
        "DERIVED",
        "EXCHANGE_DATA",
        "MARKET_DATA",
        "NOT_APPLICABLE"
      ]
    },
    "verificationEnum": {
      "enum": [
        "VERIFIED",
        "UNVERIFIED"
      ]
    },
    "sourceRef": {
      "type": "object",
      "required": [
        "source_id",
        "source_type"
      ],
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "type": "string"
        },
        "source_type": {
          "$ref": "#/$defs/sourceTypeEnum"
        },
        "uri": {
          "type": "string"
        },
        "content_hash": {
          "type": "string",
          "description": "SHA-256 digest of source document or payload"
        },
        "retrieval_timestamp": {
          "$ref": "#/$defs/dateTime"
        },
        "source_timestamp": {
          "$ref": "#/$defs/dateTime"
        },
        "note": {
          "type": "string",
          "description": "Classification note, e.g. 'PRICE_BAND_NOTICE' for EXCHANGE sources"
        }
      }
    },
    "provenanceValue": {
      "type": "object",
      "required": [
        "source_id"
      ],
      "additionalProperties": false,
      "properties": {
        "raw_value": {},
        "normalized_value": {},
        "unit": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_id": {
          "type": "string"
        },
        "locator": {
          "type": "string",
          "description": "Human-checkable document locator, e.g. 'Page 1, Offer Details Box'"
        },
        "page": {
          "type": [
            "integer",
            "null"
          ]
        },
        "section": {
          "type": [
            "string",
            "null"
          ]
        },
        "quote": {
          "type": [
            "string",
            "null"
          ]
        },
        "extraction_method": {
          "$ref": "#/$defs/extractionMethodEnum"
        },
        "verification": {
          "$ref": "#/$defs/verificationEnum"
        },
        "confidence": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "as_of": {
          "$ref": "#/$defs/dateTime"
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "derivedValue": {
      "type": "object",
      "required": [
        "is_derived",
        "formula",
        "dependencies"
      ],
      "additionalProperties": false,
      "properties": {
        "is_derived": {
          "const": true
        },
        "calculated_value": {},
        "formula": {
          "type": "string",
          "description": "Mathematical formula used for calculation"
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "List of source field paths consumed, e.g. ['issue.fresh_issue', 'price_band.price_band_high']"
        },
        "unit": {
          "type": [
            "string",
            "null"
          ]
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "analystAssessmentItem": {
      "type": "object",
      "required": [
        "value",
        "assessed_by",
        "assessment_timestamp",
        "source_id"
      ],
      "additionalProperties": false,
      "properties": {
        "value": {
          "type": [
            "string",
            "null"
          ]
        },
        "assessed_by": {
          "type": "string",
          "description": "Mandatory analyst identity/attribution for Tier-4 judgment"
        },
        "assessment_timestamp": {
          "$ref": "#/$defs/dateTime"
        },
        "assessment_note": {
          "type": "string",
          "description": "Mandatory qualitative justification/rationale"
        },
        "verification": {
          "$ref": "#/$defs/verificationEnum",
          "default": "UNVERIFIED"
        },
        "source_id": {
          "type": "string"
        }
      }
    }
  },
  "properties": {
    "contract_version": {
      "type": "string",
      "pattern": "^1\\.[0-9]+(\\.[0-9]+)?$"
    },
    "ipo_id": {
      "type": "string"
    },
    "as_of": {
      "$ref": "#/$defs/dateTime"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/sourceRef"
      }
    },
    "price_band": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "price_band_high": {
          "$ref": "#/$defs/provenanceValue"
        },
        "price_band_low": {
          "$ref": "#/$defs/provenanceValue"
        },
        "lot_size": {
          "$ref": "#/$defs/provenanceValue"
        },
        "open_date": {
          "$ref": "#/$defs/provenanceValue"
        },
        "close_date": {
          "$ref": "#/$defs/provenanceValue"
        }
      }
    },
    "market_data": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "subscription": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "as_of": {
              "$ref": "#/$defs/dateTime"
            },
            "qib_x": {
              "$ref": "#/$defs/num"
            },
            "nii_x": {
              "$ref": "#/$defs/num"
            },
            "retail_x": {
              "$ref": "#/$defs/num"
            },
            "overall_x": {
              "$ref": "#/$defs/num"
            },
            "source_id": {
              "type": "string"
            },
            "extraction_method": {
              "$ref": "#/$defs/extractionMethodEnum"
            },
            "verification": {
              "$ref": "#/$defs/verificationEnum"
            }
          }
        },
        "gmp": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "as_of": {
              "$ref": "#/$defs/dateTime"
            },
            "pct": {
              "$ref": "#/$defs/pct"
            },
            "trend": {
              "enum": [
                "strong",
                "flat",
                "falling",
                null
              ]
            },
            "source_id": {
              "type": "string"
            },
            "extraction_method": {
              "$ref": "#/$defs/extractionMethodEnum"
            },
            "verification": {
              "$ref": "#/$defs/verificationEnum"
            }
          }
        },
        "regime": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "as_of": {
              "$ref": "#/$defs/dateTime"
            },
            "nifty_trend": {
              "enum": [
                "supportive",
                "neutral",
                "weak",
                null
              ]
            },
            "last_ipo_listing_gains_pct": {
              "type": "array",
              "items": {
                "type": "number"
              }
            },
            "source_id": {
              "type": "string"
            },
            "extraction_method": {
              "$ref": "#/$defs/extractionMethodEnum"
            },
            "verification": {
              "$ref": "#/$defs/verificationEnum"
            }
          }
        },
        "anchor": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "as_of": {
              "$ref": "#/$defs/dateTime"
            },
            "quality": {
              "enum": [
                "reputed",
                "mixed",
                "unknown",
                null
              ]
            },
            "source_id": {
              "type": "string"
            },
            "extraction_method": {
              "$ref": "#/$defs/extractionMethodEnum"
            },
            "verification": {
              "$ref": "#/$defs/verificationEnum"
            }
          }
        }
      }
    },
    "peer_data": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "as_of": {
          "$ref": "#/$defs/dateTime"
        },
        "source_id": {
          "type": "string"
        },
        "peers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "pe": {
                "$ref": "#/$defs/num"
              },
              "ev_ebitda": {
                "$ref": "#/$defs/num"
              },
              "pb": {
                "$ref": "#/$defs/num"
              },
              "ps": {
                "$ref": "#/$defs/num"
              },
              "roe_pct": {
                "$ref": "#/$defs/pct"
              },
              "roa_pct": {
                "$ref": "#/$defs/pct"
              },
              "as_of": {
                "$ref": "#/$defs/dateTime"
              },
              "source_id": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "analyst_assessment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "moat_rating": {
          "allOf": [
            {
              "$ref": "#/$defs/analystAssessmentItem"
            },
            {
              "properties": {
                "value": {
                  "enum": [
                    "leader_with_moat",
                    "strong_niche",
                    "follower",
                    "commoditised",
                    null
                  ]
                }
              }
            }
          ]
        },
        "visibility_rating": {
          "allOf": [
            {
              "$ref": "#/$defs/analystAssessmentItem"
            },
            {
              "properties": {
                "value": {
                  "enum": [
                    "strong",
                    "moderate",
                    "none",
                    null
                  ]
                }
              }
            }
          ]
        }
      }
    },
    "derived": {
      "type": "object",
      "description": "Dynamically derived structural quantities (distinct from raw source facts)",
      "additionalProperties": false,
      "properties": {
        "fresh_shares": {
          "$ref": "#/$defs/derivedValue"
        },
        "post_issue_shares": {
          "$ref": "#/$defs/derivedValue"
        },
        "ofs_amount": {
          "$ref": "#/$defs/derivedValue"
        },
        "post_issue_eps": {
          "$ref": "#/$defs/derivedValue"
        },
        "promoter_post_pct": {
          "$ref": "#/$defs/derivedValue"
        }
      }
    },
    "overrides": {
      "type": "object",
      "additionalProperties": true,
      "description": "Explicit analyst overrides with signed rationale and timestamp"
    }
  }
}
