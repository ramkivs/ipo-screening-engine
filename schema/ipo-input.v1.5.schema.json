{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ipo-input.v1.5.schema.json",
  "title": "IPO screening canonical input (v1.5)",
  "description": "Canonical input for the v1.5 engine. Monetary values are in the unit named by financials.reporting_unit and are normalised to INR_CRORES before scoring. Use null (or omit the key) for unknown values; never 0. Validation is a hard gate: an input that does not satisfy this schema stops scoring.",
  "type": "object",
  "required": [
    "ipo_id",
    "company_name",
    "board",
    "icdr_route",
    "sector_profile",
    "issue",
    "financials",
    "capital_structure",
    "use_of_proceeds",
    "governance",
    "business",
    "peers"
  ],
  "additionalProperties": false,
  "$defs": {
    "num": {
      "type": [
        "number",
        "null"
      ]
    },
    "pct": {
      "type": [
        "number",
        "null"
      ],
      "minimum": -1000,
      "maximum": 10000
    },
    "date": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "dateTime": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "reportingUnit": {
      "enum": [
        "INR_CRORES",
        "INR_LAKHS",
        "INR_MILLIONS",
        "INR_BILLIONS"
      ]
    },
    "seller": {
      "type": "object",
      "required": [
        "type",
        "pre_issue_shares",
        "shares_sold"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "type": {
          "enum": [
            "promoter",
            "promoter_group",
            "pe_vc",
            "other"
          ]
        },
        "pre_issue_shares": {
          "type": "number",
          "minimum": 0,
          "description": "this selling shareholder's own pre-offer shares; must be a number, not a numeric string"
        },
        "shares_sold": {
          "type": "number",
          "minimum": 0
        },
        "holding_pct_pre_issue": {
          "$ref": "#/$defs/pct"
        },
        "source_id": {
          "type": "string"
        }
      }
    },
    "period": {
      "type": "object",
      "required": [
        "fy"
      ],
      "additionalProperties": false,
      "properties": {
        "fy": {
          "type": "string",
          "description": "e.g. FY2025, or 9M-FY2026 for a stub"
        },
        "is_stub": {
          "type": "boolean"
        },
        "revenue": {
          "$ref": "#/$defs/num"
        },
        "ebitda": {
          "$ref": "#/$defs/num"
        },
        "ebit": {
          "$ref": "#/$defs/num"
        },
        "pat": {
          "$ref": "#/$defs/num"
        },
        "pbt": {
          "$ref": "#/$defs/num"
        },
        "tax": {
          "$ref": "#/$defs/num"
        },
        "net_worth": {
          "$ref": "#/$defs/num"
        },
        "total_debt": {
          "$ref": "#/$defs/num"
        },
        "interest_expense": {
          "$ref": "#/$defs/num"
        },
        "finance_cost": {
          "$ref": "#/$defs/num"
        },
        "depreciation": {
          "$ref": "#/$defs/num"
        },
        "other_income": {
          "$ref": "#/$defs/num"
        },
        "cfo": {
          "$ref": "#/$defs/num"
        },
        "capex": {
          "$ref": "#/$defs/num"
        },
        "cash_and_equivalents": {
          "$ref": "#/$defs/num"
        },
        "trade_receivables": {
          "$ref": "#/$defs/num"
        },
        "inventory": {
          "$ref": "#/$defs/num"
        },
        "receivable_days": {
          "$ref": "#/$defs/num"
        },
        "disclosed_roce_pct": {
          "$ref": "#/$defs/pct"
        },
        "contribution_margin_pct": {
          "$ref": "#/$defs/pct"
        },
        "operating_loss_pct_revenue": {
          "$ref": "#/$defs/pct"
        },
        "nim_pct": {
          "$ref": "#/$defs/pct"
        },
        "cost_to_income_pct": {
          "$ref": "#/$defs/pct"
        },
        "gnpa_pct": {
          "$ref": "#/$defs/pct"
        },
        "nnpa_pct": {
          "$ref": "#/$defs/pct"
        },
        "provision_coverage_pct": {
          "$ref": "#/$defs/pct"
        },
        "crar_pct": {
          "$ref": "#/$defs/pct"
        },
        "tier1_pct": {
          "$ref": "#/$defs/pct"
        },
        "roa_pct": {
          "$ref": "#/$defs/pct"
        },
        "roe_pct": {
          "$ref": "#/$defs/pct"
        },
        "order_book": {
          "$ref": "#/$defs/num"
        },
        "pre_sales": {
          "$ref": "#/$defs/num"
        },
        "collections": {
          "$ref": "#/$defs/num"
        },
        "source_id": {
          "type": "string"
        }
      }
    },
    "sourceRef": {
      "type": "object",
      "required": [
        "source_id"
      ],
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "type": "string"
        },
        "source_type": {
          "enum": [
            "RHP",
            "DRHP",
            "EXCHANGE",
            "MARKET_DATA",
            "PEER_DATA",
            "STRUCTURED_INPUT",
            "DERIVED"
          ]
        },
        "uri": {
          "type": "string"
        },
        "content_hash": {
          "type": "string"
        },
        "retrieval_timestamp": {
          "$ref": "#/$defs/dateTime"
        },
        "source_timestamp": {
          "$ref": "#/$defs/dateTime"
        }
      }
    },
    "evidenceRef": {
      "type": "object",
      "required": [
        "source_id"
      ],
      "additionalProperties": false,
      "properties": {
        "evidence_id": {
          "type": "string"
        },
        "source_id": {
          "type": "string"
        },
        "locator": {
          "type": "string",
          "description": "human-checkable pointer, e.g. 'p.73 Summary of Restated Financial Statements'"
        },
        "page": {
          "type": [
            "integer",
            "null"
          ]
        },
        "section": {
          "type": [
            "string",
            "null"
          ]
        },
        "quote": {
          "type": [
            "string",
            "null"
          ]
        },
        "as_of": {
          "$ref": "#/$defs/dateTime"
        },
        "extraction_method": {
          "enum": [
            "MANUAL_ENTRY",
            "STRUCTURED_INPUT",
            "DETERMINISTIC_PDF",
            "TABLE_EXTRACTION",
            "OCR",
            "LLM_ASSISTED",
            "DERIVED",
            "EXCHANGE_DATA",
            "MARKET_DATA",
            "NOT_APPLICABLE"
          ]
        },
        "extraction_confidence": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "note": {
          "type": [
            "string",
            "null"
          ],
          "description": "free-text provenance annotation kept with the evidence"
        },
        "page_note": {
          "type": [
            "string",
            "null"
          ],
          "description": "note about how the page was read, e.g. a [●] marker that must not be treated as a value"
        },
        "quoted_text": {
          "type": [
            "string",
            "null"
          ],
          "description": "accepted alias for 'quote'. The evidence registry emits this spelling, so a frozen input snapshot can be re-loaded and re-evaluated unchanged (replay, spec s19)."
        }
      }
    }
  },
  "properties": {
    "ipo_id": {
      "type": "string"
    },
    "company_name": {
      "type": "string"
    },
    "exchange": {
      "enum": [
        "NSE",
        "BSE",
        "BOTH"
      ]
    },
    "board": {
      "enum": [
        "mainboard",
        "sme"
      ]
    },
    "icdr_route": {
      "enum": [
        "6(1)",
        "6(2)"
      ]
    },
    "sector": {
      "type": "string"
    },
    "sector_profile": {
      "enum": [
        "standard",
        "financial",
        "epc_real_estate",
        "cyclical"
      ]
    },
    "drhp_filing_date": {
      "$ref": "#/$defs/date"
    },
    "metric_overrides": {
      "type": "object",
      "additionalProperties": true,
      "description": "Manual values for any derived metric named in the config derived_metrics registry. Wins over computed values, and is recorded as an override in the audit trail."
    },
    "issue": {
      "type": "object",
      "required": [
        "price_band_low",
        "price_band_high",
        "fresh_issue",
        "ofs",
        "open_date",
        "close_date"
      ],
      "additionalProperties": false,
      "properties": {
        "price_band_low": {
          "type": "number"
        },
        "price_band_high": {
          "type": "number"
        },
        "lot_size": {
          "type": "integer"
        },
        "fresh_issue": {
          "type": "number",
          "minimum": 0,
          "description": "in reporting_unit"
        },
        "ofs": {
          "type": "number",
          "minimum": 0,
          "description": "in reporting_unit"
        },
        "fresh_shares": {
          "$ref": "#/$defs/num"
        },
        "post_issue_shares": {
          "$ref": "#/$defs/num"
        },
        "pre_issue_shares": {
          "$ref": "#/$defs/num"
        },
        "post_issue_eps": {
          "$ref": "#/$defs/num",
          "description": "INR per share, at the upper price band"
        },
        "open_date": {
          "type": "string",
          "format": "date"
        },
        "close_date": {
          "type": "string",
          "format": "date"
        },
        "listing_date": {
          "$ref": "#/$defs/date"
        },
        "quota_pct": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "anchor": {
              "$ref": "#/$defs/pct"
            },
            "qib": {
              "$ref": "#/$defs/pct"
            },
            "nii": {
              "$ref": "#/$defs/pct"
            },
            "retail": {
              "$ref": "#/$defs/pct"
            }
          }
        },
        "employee_discount_pct": {
          "$ref": "#/$defs/pct"
        },
        "shareholder_discount_pct": {
          "$ref": "#/$defs/pct"
        },
        "anchor_allocation": {
          "$ref": "#/$defs/num"
        },
        "promoter_lockin_months": {
          "$ref": "#/$defs/num"
        },
        "ofs_sellers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/seller"
          }
        },
        "post_issue_eps_basis": {
          "enum": [
            "disclosed",
            "derived"
          ],
          "description": "How issue.post_issue_eps was obtained. `disclosed` means the filing printed a post-issue earnings figure (quote and period recorded in _evidence); `derived` means the engine formed it as latest full-year PAT / post-issue shares, with the derivation recorded in _evidence. Absent for inputs that pre-date this field; such a value is not attributed to either basis and is reconciled against PAT by the semantic validator."
        }
      }
    },
    "financials": {
      "type": "object",
      "required": [
        "reporting_unit",
        "periods"
      ],
      "additionalProperties": false,
      "properties": {
        "reporting_unit": {
          "$ref": "#/$defs/reportingUnit"
        },
        "periods": {
          "type": "array",
          "minItems": 3,
          "maxItems": 6,
          "items": {
            "$ref": "#/$defs/period"
          },
          "description": "oldest first; three full FYs plus an optional stub; the cyclical profile needs five FYs"
        },
        "operating_cash_flow_3yr_cumulative": {
          "description": "Three-full-FY operating cash flow, either as a cumulative amount or oldest-first annual amounts in the reporting unit.",
          "oneOf": [
            {"$ref": "#/$defs/num"},
            {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}}
          ]
        },
        "net_income_3yr_cumulative": {
          "description": "Three-full-FY net income, either as a cumulative amount or oldest-first annual amounts in the reporting unit.",
          "oneOf": [
            {"$ref": "#/$defs/num"},
            {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}}
          ]
        },
        "trade_receivables_days": {
          "$ref": "#/$defs/num"
        },
        "net_working_capital_pct_revenue": {
          "$ref": "#/$defs/pct"
        },
        "top_customer_revenue_pct": {
          "type": ["number", "null"], "minimum": 0, "maximum": 100,
          "description": "Percentage of total revenue contributed by the single largest customer."
        },
        "loss_making_segments_present": {
          "type": ["boolean", "null"],
          "description": "Whether the filing discloses material loss-making operating segments or key product lines."
        },
        "adjusted_metrics_unreconciled": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "contingent_liabilities": {
          "$ref": "#/$defs/num"
        },
        "contingent_liabilities_unquantified": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "regulatory_crar_min_pct": {
          "$ref": "#/$defs/pct"
        }
      }
    },
    "capital_structure": {
      "type": "object",
      "required": [
        "promoter_pre_pct",
        "promoter_post_pct"
      ],
      "additionalProperties": false,
      "properties": {
        "promoter_pre_pct": {
          "$ref": "#/$defs/pct"
        },
        "promoter_post_pct": {
          "$ref": "#/$defs/pct"
        },
        "promoter_pledge_pct": {
          "$ref": "#/$defs/pct"
        },
        "promoter_lockin_in_place": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "large_holders_unlocked_early": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "pre_ipo_placements": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "date",
              "price"
            ],
            "additionalProperties": false,
            "properties": {
              "date": {
                "type": "string",
                "format": "date"
              },
              "price": {
                "type": "number"
              },
              "shares": {
                "type": "number"
              }
            }
          }
        },
        "discounted_allotments_18m_before_drhp": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "heavy non-pro-rata ESOP/bonus/rights/preferential allotments at a discount within 18 months before DRHP filing"
        },
        "promoter_group_pre_shares": {
          "$ref": "#/$defs/num"
        }
      }
    },
    "use_of_proceeds": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "category"
        ],
        "additionalProperties": false,
        "properties": {
          "category": {
            "enum": [
              "growth_capex",
              "rnd",
              "working_capital",
              "debt_repayment",
              "acquisition_identified",
              "acquisition_unidentified",
              "gcp",
              "other"
            ]
          },
          "amount": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "description": "in reporting_unit. null means undisclosed (the RHP shows [●]); it is never replaced by the legal maximum."
          },
          "undisclosed_marker": {
            "type": "string",
            "description": "the marker as printed in the RHP, typically [●]"
          }
        }
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "promoter_pledged_shares_pct": {
          "type": ["number", "null"], "minimum": 0, "maximum": 100
        },
        "pre_issue_promoter_holding_pct": {
          "type": ["number", "null"], "minimum": 0, "maximum": 100
        },
        "professionally_managed_without_identifiable_promoters": {
          "type": ["boolean", "null"],
          "description": "Explicit filing classification used only to exempt the low pre-issue promoter holding check."
        },
        "auditor_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "auditor_opinion": {
          "enum": [
            "unqualified",
            "emphasis_of_matter",
            "qualified",
            "adverse",
            "disclaimer",
            null
          ]
        },
        "going_concern_uncertainty": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "eom_materiality": {
          "enum": [
            "none",
            "low",
            "medium",
            "high",
            null
          ]
        },
        "eom_count_3y": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "repeated_eom": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "caro_remarks": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "auditor_changed_3y": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "auditor_change_count_3y": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "auditor_reputed": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "auditor_or_cfo_exit_2y": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "litigation_bucket": {
          "enum": [
            "clean",
            "minor_civil",
            "criminal_or_regulatory",
            null
          ]
        },
        "sebi_ed_action_active": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "regulatory_actions": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "rpt_pct_revenue": {
          "$ref": "#/$defs/pct"
        },
        "rpt_pct_of_revenue_growth": {
          "$ref": "#/$defs/pct"
        },
        "board_independent_majority": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "independent_director_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "kmp_exits_2y": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "board_changes": {
          "type": [
            "array",
            "null"
          ],
          "description": "Dated director / key-managerial-personnel events read from the changes-in-directorate table. The 24-month exit window is applied at evaluation time, not here.",
          "items": {
            "type": "object",
            "required": [
              "date",
              "event"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "role": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "event": {
                "enum": [
                  "resignation",
                  "cessation",
                  "retirement",
                  "term_expiry",
                  "appointment",
                  "other"
                ]
              },
              "date": {
                "type": "string",
                "format": "date"
              },
              "reason": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      }
    },
    "business": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "industry_cagr_pct": {
          "$ref": "#/$defs/pct"
        },
        "industry_scope": {
          "enum": [
            "india",
            "global",
            "regional",
            null
          ],
          "description": "spec s12 requires the scope alongside the value"
        },
        "industry_forecast_period": {
          "type": [
            "string",
            "null"
          ],
          "description": "e.g. FY2026-FY2031"
        },
        "industry_source": {
          "type": [
            "string",
            "null"
          ],
          "description": "the independent industry report cited in the RHP"
        },
        "industry_is_primary": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "moat_rating": {
          "enum": [
            "leader_with_moat",
            "strong_niche",
            "follower",
            "commoditised",
            null
          ]
        },
        "top5_customer_pct": {
          "$ref": "#/$defs/pct"
        },
        "top5_supplier_pct": {
          "$ref": "#/$defs/pct"
        },
        "visibility_rating": {
          "enum": [
            "strong",
            "moderate",
            "none",
            null
          ]
        },
        "regulatory_dependence": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "segments": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "capacity_utilisation_pct": {
          "$ref": "#/$defs/pct"
        },
        "order_book": {
          "$ref": "#/$defs/num"
        },
        "order_book_visibility": {
          "enum": [
            "strong",
            "moderate",
            "none",
            null
          ]
        }
      }
    },
    "risks": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "contingent_liabilities_pct_net_worth": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "material_regulatory_disputes_present": {
          "type": ["boolean", "null"]
        }
      }
    },
    "peers": {
      "type": "array",
      "description": "Genuine comparable companies. An empty array is permitted (D-PEER-1) and means no peer data is available: peer-relative metrics resolve UNKNOWN. Synthetic placeholder peers must never be inserted to satisfy this field.",
      "minItems": 0,
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "additionalProperties": false,
        "properties": {
          "peer_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "business_match": {
            "enum": [
              "match",
              "partial",
              "mismatch",
              "unusable",
              "not_comparable",
              null
            ]
          },
          "listed_years": {
            "type": [
              "number",
              "null"
            ]
          },
          "listing_date": {
            "$ref": "#/$defs/date"
          },
          "as_of": {
            "$ref": "#/$defs/date"
