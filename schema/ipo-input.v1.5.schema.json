      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/evidenceRef"
      }
    },
    "coverage": {
      "type": "object",
      "description": "Per-field extraction coverage. A field listed here records what the reader established about the source section: DISCLOSED (read, values supplied), VERIFIED_NIL (read, and the filing positively discloses nothing), PARTIAL (section found but only partly read), UNREAD (not examined). A document that omits this map entirely is a legacy v1.5 input and keeps v1.5 behaviour; once the map is present, a field it does not mention is UNREAD.",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "enum": [
          "DISCLOSED",
          "VERIFIED_NIL",
          "PARTIAL",
          "UNREAD"
        ]
      }
    }
