{
 "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"operator-scenario.v1.schema.json","type":"object","additionalProperties":false,
 "required":["contract_name","contract_version","target_id","scenario_id","created_at","operator_id","peer_assertions","qualitative_assertions","limitations","canonical_scenario_hash"],
 "properties":{
  "contract_name":{"const":"IPO_LAYER_3_OPERATOR_SCENARIO"},"contract_version":{"const":"1.0"},"target_id":{"type":"string","minLength":1},"scenario_id":{"type":"string","pattern":"^SCN-[0-9a-f]{16}$"},"created_at":{"type":"string","format":"date-time"},"operator_id":{"type":"string","minLength":1},"canonical_scenario_hash":{"type":"string","pattern":"^[0-9a-f]{64}$"},
  "peer_assertions":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["peer_name","pe","as_of","points_delta","justification"],"properties":{"peer_name":{"type":"string","minLength":1},"pe":{"type":"number","exclusiveMinimum":0},"as_of":{"type":"string","format":"date"},"points_delta":{"type":"number","minimum":-20,"maximum":20},"justification":{"type":"string","minLength":1}}}},
  "qualitative_assertions":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["criterion","rating","points_delta","justification"],"properties":{"criterion":{"enum":["management_quality","moat","industry_growth","concentration","visibility"]},"rating":{"enum":["LOW","MEDIUM","HIGH"]},"points_delta":{"type":"number","minimum":-15,"maximum":15},"justification":{"type":"string","minLength":1}}}},
  "limitations":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string"}}
 }
}
